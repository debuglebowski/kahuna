{
  "name": "kingsmaker",
  "version": "0.0.0",
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@types/bun": "1.3.14",
    "typescript": "6.0.3"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "private": true,
  "scripts": {
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "health": "bun apps/web/server/health.ts",
    "db:generate": "bun run --filter @kingsmaker/web db:generate",
    "db:migrate": "bun run --filter @kingsmaker/web db:migrate",
    "db:check": "bun run --filter @kingsmaker/web db:check",
    "snapshot": "bash scripts/snapshot.sh",
    "dev:web": "bun run --filter @kingsmaker/web dev",
    "serve:web": "bun run --filter @kingsmaker/web serve"
  },
  "type": "module",
  "workspaces": [
    "apps/*"
  ]
}
