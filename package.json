{
  "name": "kingsmaker",
  "version": "0.0.9",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "bun": ">=1.3.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd packages/app dev",
    "build": "bun run --cwd packages/app build",
    "serve": "bun run --cwd packages/app serve",
    "health": "bun run --cwd packages/app health",
    "seed": "bun run --cwd packages/app seed",
    "bootstrap": "bun run --cwd packages/app bootstrap",
    "typecheck": "tsc -p packages/contract && tsc -p packages/app && tsc -p packages/cli",
    "check:imports": "bun run --cwd packages/app check:imports",
    "test": "bun run --cwd packages/app test && bun run --cwd packages/cli test",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "db:generate": "bun run --cwd packages/app db:generate",
    "db:migrate": "bun run --cwd packages/app db:migrate",
    "db:check": "bun run --cwd packages/app db:check",
    "snapshot": "bash scripts/snapshot.sh",
    "version:set": "bun scripts/version.ts",
    "version:check": "bun scripts/version.ts --check",
    "release": "bash scripts/release.sh",
    "cli": "bun run --cwd packages/cli start",
    "cli:build": "bun run --cwd packages/cli build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "typescript": "6.0.3"
  }
}
