{
  "name": "kingsmaker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.3.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "cd app && vite",
    "build": "cd app && vite build",
    "serve": "cd app && bun server/index.ts",
    "health": "cd app && bun server/health.ts",
    "seed": "cd app && bun server/seed/run.ts",
    "bootstrap": "cd app && bun scripts/bootstrap.ts",
    "typecheck": "tsc -p packages/contract && tsc -p app",
    "check:imports": "cd app && bun scripts/check-image-imports.ts server/index.ts scripts/bootstrap.ts",
    "test": "cd app && vitest run",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "db:generate": "cd app && drizzle-kit generate",
    "db:migrate": "cd app && drizzle-kit migrate",
    "db:check": "cd app && drizzle-kit check",
    "snapshot": "bash scripts/snapshot.sh"
  },
  "imports": {
    "#engine": "./app/engine/index.ts",
    "#engine/*": "./app/engine/*",
    "#db": "./app/db/index.ts",
    "#db/*": "./app/db/*"
  },
  "dependencies": {
    "@kingsmaker/contract": "workspace:*",
    "@azure/identity": "^4.13.1",
    "@azure/storage-blob": "^12.33.0",
    "@better-auth/sso": "1.6.14",
    "@dagrejs/dagre": "3.0.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@effect/experimental": "0.60.0",
    "@effect/platform": "0.96.1",
    "@effect/rpc": "0.75.1",
    "@effect/sql": "0.51.1",
    "@effect/sql-pg": "0.52.1",
    "@fontsource-variable/geist": "^5.2.9",
    "@tanstack/db": "0.6.8",
    "@tanstack/query-db-collection": "1.0.39",
    "@tanstack/react-db": "0.1.86",
    "@tanstack/react-query": "5.101.0",
    "@tiptap/core": "3.26.0",
    "@tiptap/extensions": "^3.26.0",
    "@tiptap/pm": "^3.26.0",
    "@tiptap/react": "^3.26.0",
    "@tiptap/starter-kit": "^3.26.0",
    "@tiptap/suggestion": "3.26.0",
    "@xyflow/react": "12.11.0",
    "better-auth": "1.6.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "d3-force": "^3.0.0",
    "date-fns": "^3",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "effect": "3.21.3",
    "elkjs": "^0.11.1",
    "lucide-react": "1.17.0",
    "pg": "8.21.0",
    "radix-ui": "^1.5.0",
    "react": "19.2.7",
    "react-day-picker": "^8",
    "react-dom": "19.2.7",
    "react-grid-layout": "1.5.3",
    "react-markdown": "^10.1.0",
    "react-resizable": "3.0.5",
    "react-router-dom": "7.17.0",
    "recharts": "3.8.1",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@effect/vitest": "0.29.0",
    "@tailwindcss/vite": "4.3.0",
    "@types/bun": "1.3.14",
    "@types/d3-force": "^3.0.10",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/react-grid-layout": "1.3.6",
    "@vitejs/plugin-react": "6.0.2",
    "tailwindcss": "4.3.0",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "vitest": "3.2.6"
  }
}
