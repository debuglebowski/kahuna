# Postgres (matches docker-compose.yml — host port 5544 to avoid local 5432 conflicts)
DATABASE_URL=postgresql://kingsmaker:kingsmaker@localhost:5544/kingsmaker

# Dedicated database for the test suite (Phase 1+)
TEST_DATABASE_URL=postgresql://kingsmaker:kingsmaker@localhost:5544/kingsmaker_test

# BetterAuth (Phase 2)
BETTER_AUTH_SECRET=dev-secret-change-me
BETTER_AUTH_URL=http://localhost:3100
# Comma-separated origins allowed to call auth (CSRF). Defaults cover :3100 + Vite dev ports.
# TRUSTED_ORIGINS=http://localhost:3100,http://localhost:5100

# Web server
PORT=3100

# Initial admin — `bun run bootstrap` creates this owner + a seeded org, but only
# while the database has no accounts at all. Unset here because the dev database
# usually already has users; `scripts/create-admin.ts` is the manual path.
# INITIAL_ADMIN_EMAIL=admin@localhost
# INITIAL_ADMIN_PASSWORD=
# INITIAL_ORG_NAME=Kingsmaker

# Blob storage (Phase 4): local | s3
BLOB_DRIVER=local
BLOB_LOCAL_DIR=./.blobstore
