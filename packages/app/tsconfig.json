{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["@types/bun"],
    "paths": {
      "@/*": ["./src/*"]
      // `#engine` and `#db` (the former packages/engine + packages/db) resolve
      // through the `imports` field in package.json, not through `paths` — that
      // works for tsc, Bun, and vitest without needing the deprecated `baseUrl`,
      // and it keeps working on a fresh clone with no node_modules symlink.
      // `engine/index.ts` is still the seam into the domain core.
    }
  },
  "include": [
    "src",
    "server",
    // No "rpc" — the wire contract is its own package (`@kahunalabs/contract`,
    // typechecked by `tsc -p packages/contract`), so that server, SPA and CLI
    // all consume one owner by name instead of by relative path.
    "engine",
    "db",
    "test",
    // Was missing entirely, so NOTHING under scripts/ was ever typechecked —
    // not the ones that live here, nor the two that used to sit in the repo-root
    // scripts/ (outside every tsconfig). They import server/engine internals, so
    // a contract change would otherwise only surface when someone ran one.
    "scripts",
    "vite.config.ts",
    "vitest.config.ts",
    "drizzle.config.ts"
  ]
}
