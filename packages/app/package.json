{
  "name": "@kingsmaker/app",
  "version": "0.0.8",
  "private": true,
  "license": "MIT",
  "description": "The Kingsmaker deployment: Bun server, React SPA, domain engine and the one migration set.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "serve": "bun server/index.ts",
    "health": "bun server/health.ts",
    "seed": "bun server/seed/run.ts",
    "bootstrap": "bun scripts/bootstrap.ts",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "check:imports": "bun scripts/check-image-imports.ts server/index.ts scripts/bootstrap.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
