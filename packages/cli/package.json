{
  "name": "@kingsmaker/cli",
  "version": "0.0.7",
  "description": "The Kingsmaker command line \u2014 km.",
  "type": "module",
  "bin": {
    "km": "./dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "start": "bun index.ts",
    "build": "bun build index.ts --target=node --outdir dist --minify",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@effect/platform": "0.96.1",
    "@effect/rpc": "0.75.1",
    "@kingsmaker/contract": "workspace:*",
    "@types/node": "25.9.2",
    "effect": "3.21.3",
    "vitest": "3.2.6"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/debuglebowski/kingsmaker.git",
    "directory": "packages/cli"
  },
  "keywords": [
    "kingsmaker",
    "cli"
  ],
  "publishConfig": {
    "access": "public"
  }
}
