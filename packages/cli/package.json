{
  "name": "@kahunalabs/cli",
  "version": "0.0.9",
  "description": "The Kahuna command line \u2014 kahuna.",
  "type": "module",
  "bin": {
    "kahuna": "./dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "start": "bun index.ts",
    "build": "bun build index.ts --target=node --outdir dist --minify",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@effect/platform": "0.97.2",
    "@effect/rpc": "0.76.2",
    "@kahunalabs/contract": "workspace:*",
    "@types/node": "25.9.2",
    "effect": "3.21.3",
    "vitest": "3.2.6"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/debuglebowski/kahuna.git",
    "directory": "packages/cli"
  },
  "keywords": [
    "kahuna",
    "cli"
  ],
  "publishConfig": {
    "access": "public"
  }
}
