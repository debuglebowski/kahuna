# Production env for docker-compose.prod.yml. Copy to `.env.production` and fill in.
# Keep it mode 600 and out of git (.env* is already gitignored except examples).

# --- Postgres (read by BOTH services; compose builds DATABASE_URL from these) ---
POSTGRES_USER=kingsmaker
POSTGRES_PASSWORD=            # REQUIRED — openssl rand -base64 24
POSTGRES_DB=kingsmaker

# --- Image ---
# ALLTING_IMAGE=ghcr.io/debuglebowski/allting:latest
# Pin to a digest or SHA tag for reproducible deploys:
# ALLTING_IMAGE=ghcr.io/debuglebowski/allting:sha-abc1234

# --- App ---
# NODE_ENV=production is baked into the image. It is load-bearing: without it the
# auth layer keeps dev's http://localhost:* trusted-origin globs.

# REQUIRED — openssl rand -base64 32. Rotating it invalidates all sessions.
BETTER_AUTH_SECRET=

# REQUIRED — the public origin, scheme included, no trailing slash. Used for
# cookies, CSRF/trusted origins, and OAuth redirects. A mismatch here is the most
# common cause of "logged out immediately after signing in".
BETTER_AUTH_URL=https://allting.example.com

# Extra origins allowed to call auth (comma-separated). The BETTER_AUTH_URL origin
# is always trusted; leave this empty when the SPA is served same-origin, which it
# is in this image.
# TRUSTED_ORIGINS=

# --- Initial admin ---
# Self-serve sign-up is closed, so an empty database has no way in. Set both of
# these and the `migrate` step creates one owner account plus one seeded org —
# but ONLY while the deployment has no accounts at all. Once anyone exists it is
# a permanent no-op, so leaving these set across upgrades is fine and deleting
# the initial admin later does not resurrect it.
#
# Leave them unset and no admin is created; provision by hand instead with
# `scripts/create-admin.ts`.
#
# THIS ACCOUNT IS MEANT TO BE TEMPORARY. After the first sign-in: add your own
# account in Settings -> Members, promote it to `owner`, THEN delete this one —
# in that order, because the last-owner guard refuses to remove the only owner.
# Note that removing a member removes the MEMBERSHIP; the user row survives.
#
# Minimum 8 characters. There is no mail provider wired up, so the address is
# only ever a login identifier — it is never sent to.
# INITIAL_ADMIN_EMAIL=admin@allting.example.com
# INITIAL_ADMIN_PASSWORD=          # openssl rand -base64 18
# INITIAL_ORG_NAME=Allting      # renameable later in Settings

# --- Blob storage ---
# BLOB_LOCAL_DIR defaults to /data/blobstore in the image, backed by the
# kingsmaker_blobs volume. It is CWD-relative if you override it with a relative
# path — always use an absolute one. Uploads are NOT in pg_dump; back up the
# volume too, or use s3 below.
# BLOB_DRIVER=s3
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=            # for S3-compatible providers (R2, MinIO, Spaces)
#
# Azure Blob Storage is its OWN driver, not an S3_ENDPOINT — Azure serves no
# S3-compatible API. Create the container yourself first; the server never does
# (`az storage container create -n <name> --account-name <account>`).
#
# Three ways to authenticate, tried in this order:
#   1. AZURE_STORAGE_CONNECTION_STRING — carries its own endpoint, so
#      AZURE_STORAGE_ENDPOINT is IGNORED when this is set.
#   2. AZURE_STORAGE_ACCOUNT + AZURE_STORAGE_KEY — shared key.
#   3. AZURE_STORAGE_ACCOUNT alone — managed identity (preferred). No secret in
#      the environment at all: on Azure Container Apps assign a user-assigned
#      managed identity holding "Storage Blob Data Contributor" ON THE CONTAINER,
#      and it is picked up automatically. Works the same for AKS workload
#      identity, or `az login` on a developer machine.
#
# Note the failure mode of (3): a credential is built even when no identity is
# present, and only fails when a token is first requested. So a FORGOTTEN
# AZURE_STORAGE_KEY looks like "I meant managed identity" and surfaces as a
# first-upload auth error rather than a startup one.
# BLOB_DRIVER=azure
# AZURE_STORAGE_CONTAINER=
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_STORAGE_ACCOUNT=
# AZURE_STORAGE_KEY=      # omit entirely to use a managed identity
# AZURE_STORAGE_ENDPOINT= # Azurite / sovereign cloud / custom domain

# --- Update check ---
# Once an hour the server asks the GitHub Container Registry which release tags
# exist for its own image, and shows "update available" in Settings ->
# Organization when there is a newer one. It is ADVISORY: nothing is downloaded
# or applied, and upgrading stays your deploy path's job (pull the new image, run
# `migrate` with it, then `serve` — see docker-entrypoint.sh).
#
# The request is anonymous and sends no data about this install: a token fetch
# plus a tag list, both public reads of a public package. Set to 0 to disable
# entirely — required for an airgapped install, though a failed check already
# degrades quietly to "unknown" rather than erroring.
# UPDATE_CHECK_ENABLED=0
# UPDATE_CHECK_INTERVAL_MS=3600000
# Point the check at a fork or a mirror. Must be a GHCR `owner/name`.
# ALLTING_IMAGE_REPO=debuglebowski/allting

# --- Integrations (all optional; sync flags default off) ---
# REQUIRED in production (the server refuses to start encrypting without it).
# 32 bytes as base64 or 64-char hex — openssl rand -base64 32
# Losing it makes every stored OAuth/API token undecryptable. Keep it DISTINCT
# from BETTER_AUTH_SECRET: outside production the token key can be derived from
# that secret, which silently couples session rotation to token loss.
# Renamed from INTEGRATION_TOKEN_ENCRYPTION_KEY / GOOGLE_TOKEN_ENCRYPTION_KEY.
# Those names are no longer read — carry the SAME value over under the new one,
# or the tokens already in your database will not decrypt.
# INTEGRATION_ENCRYPTION_KEY=

# Inbound webhooks need a publicly reachable base URL; these default to
# BETTER_AUTH_URL when unset.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://allting.example.com/api/integrations/google/callback
# Deployment DEFAULTS for the per-org integration toggles (Settings →
# Integrations overrides these per organization). Only the literal `0`
# disables — any other value, including `true`, leaves sync ON.
# GOOGLE_SYNC_ENABLED=0
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SLACK_SIGNING_SECRET=
# LINEAR_SYNC_ENABLED=0
# POSTHOG_SYNC_ENABLED=0
# SLACK_SYNC_ENABLED=0
# GOOGLE_WATCH_ENABLED=1        # opt-IN, unlike the others
# APOLLO_ENRICH_CACHE_ENABLED=0
# APOLLO_ENRICH_CACHE_TTL_DAYS=30
# ANALYTICS_CACHE_TTL_MS=60000  # 0 disables the analytics result cache

# Gmail push (Pub/Sub) is REFUSED unless this is set — it is that endpoint's only
# authenticator, since Pub/Sub POSTs carry no signature. Append it to the push
# endpoint URL you register in Pub/Sub (`...?token=<value>`), or send it as
# `Authorization: Bearer <value>`.
# GOOGLE_PUBSUB_VERIFICATION_TOKEN=
# GOOGLE_PUBSUB_TOPIC=
# GOOGLE_WEBHOOK_BASE_URL=https://allting.example.com

# Automation `webhook` actions refuse non-public targets (loopback, RFC1918,
# 169.254.169.254 — i.e. the cloud metadata service) and will not follow a
# redirect into one.
#
# If a target really is on your own network, name it here: comma-separated
# hostnames or IPs, matched against the URL's host. A scheme, port or path on an
# entry is ignored, so `http://n8n:5678/hook` and `n8n` mean the same thing.
#
# Only the hosts you name are opened — permitting `n8n` does not permit the rest
# of that network. What a listed name RESOLVES to is still checked, so it cannot
# be repointed at something else later.
#
# Refused even for a listed host: the metadata service (169.254.0.0/16,
# fd00:ec2::254) and loopback (127.0.0.0/8, ::1, 0.0.0.0). Nothing legitimate is
# at the first; the second is this container's own internal-only surface.
#
# Address the target by HOSTNAME (`http://n8n:5678`), not by literal private IP.
# The automation editor screens URLs before saving, and that check cannot read
# this variable, so `http://10.0.0.5:5678` is rejected at save time regardless.
# AUTOMATION_WEBHOOK_ALLOW_HOSTS=n8n,nas.local
#
# REPLACES: AUTOMATION_WEBHOOK_ALLOW_PRIVATE, which is no longer read. It was
# all-or-nothing — opening one internal target opened every other service
# reachable from the container. List the hosts you actually need instead.
