# Production env for docker-compose.prod.yml. Copy to `.env.production` and fill in.
# Keep it mode 600 and out of git (.env* is already gitignored except examples).

# --- Postgres (read by BOTH services; compose builds DATABASE_URL from these) ---
POSTGRES_USER=kingsmaker
POSTGRES_PASSWORD=            # REQUIRED — openssl rand -base64 24
POSTGRES_DB=kingsmaker

# --- Image ---
# KINGSMAKER_IMAGE=ghcr.io/debuglebowski/kingsmaker:latest
# Pin to a digest or SHA tag for reproducible deploys:
# KINGSMAKER_IMAGE=ghcr.io/debuglebowski/kingsmaker:sha-abc1234

# --- App ---
# NODE_ENV=production is baked into the image. It is load-bearing: without it the
# auth layer keeps dev's http://localhost:* trusted-origin globs.

# REQUIRED — openssl rand -base64 32. Rotating it invalidates all sessions.
BETTER_AUTH_SECRET=

# REQUIRED — the public origin, scheme included, no trailing slash. Used for
# cookies, CSRF/trusted origins, and OAuth redirects. A mismatch here is the most
# common cause of "logged out immediately after signing in".
BETTER_AUTH_URL=https://kingsmaker.example.com

# Extra origins allowed to call auth (comma-separated). The BETTER_AUTH_URL origin
# is always trusted; leave this empty when the SPA is served same-origin, which it
# is in this image.
# TRUSTED_ORIGINS=

# --- Blob storage ---
# BLOB_LOCAL_DIR defaults to /data/blobstore in the image, backed by the
# kingsmaker_blobs volume. It is CWD-relative if you override it with a relative
# path — always use an absolute one. Uploads are NOT in pg_dump; back up the
# volume too, or use s3 below.
# BLOB_DRIVER=s3
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=            # for S3-compatible providers (R2, MinIO, Spaces)

# --- Update check ---
# Once an hour the server asks the GitHub Container Registry which release tags
# exist for its own image, and shows "update available" in Settings ->
# Organization when there is a newer one. It is ADVISORY: nothing is downloaded
# or applied, and upgrading stays your deploy path's job (pull the new image, run
# `migrate` with it, then `serve` — see docker-entrypoint.sh).
#
# The request is anonymous and sends no data about this install: a token fetch
# plus a tag list, both public reads of a public package. Set to 0 to disable
# entirely — required for an airgapped install, though a failed check already
# degrades quietly to "unknown" rather than erroring.
# UPDATE_CHECK_ENABLED=0
# UPDATE_CHECK_INTERVAL_MS=3600000
# Point the check at a fork or a mirror. Must be a GHCR `owner/name`.
# KINGSMAKER_IMAGE_REPO=debuglebowski/kingsmaker

# --- Integrations (all optional; sync flags default off) ---
# REQUIRED in production (the server refuses to start encrypting without it).
# 32 bytes as base64 or 64-char hex — openssl rand -base64 32
# Losing it makes every stored OAuth/API token undecryptable. Keep it DISTINCT
# from BETTER_AUTH_SECRET: outside production the token key can be derived from
# that secret, which silently couples session rotation to token loss.
# INTEGRATION_TOKEN_ENCRYPTION_KEY=

# Inbound webhooks need a publicly reachable base URL; these default to
# BETTER_AUTH_URL when unset.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://kingsmaker.example.com/api/integrations/google/callback
# GOOGLE_SYNC_ENABLED=true
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SLACK_SIGNING_SECRET=
# LINEAR_SYNC_ENABLED=true
# POSTHOG_SYNC_ENABLED=true

# Gmail push (Pub/Sub) is REFUSED unless this is set — it is that endpoint's only
# authenticator, since Pub/Sub POSTs carry no signature. Append it to the push
# endpoint URL you register in Pub/Sub (`...?token=<value>`), or send it as
# `Authorization: Bearer <value>`.
# GOOGLE_PUBSUB_VERIFICATION_TOKEN=
# GOOGLE_PUBSUB_TOPIC=
# GOOGLE_WEBHOOK_BASE_URL=https://kingsmaker.example.com

# Automation `webhook` actions refuse non-public targets (loopback, RFC1918,
# 169.254.169.254 — i.e. the cloud metadata service) and will not follow a
# redirect into one. Set to 1 ONLY if your webhook target really is on the
# internal network; it re-opens that path.
# AUTOMATION_WEBHOOK_ALLOW_PRIVATE=1
